# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon in production, local Postgres via Docker Compose)
# Start with: docker compose up -d db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaultforge?schema=public

# Auth.js (generate AUTH_SECRET with: openssl rand -base64 32)
AUTH_SECRET=generate-a-long-random-string
# Optional GitHub OAuth — leave blank to hide the GitHub button
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=


# External game catalog (server-only — never expose to the client)
RAWG_API_KEY=

# Monitoring
SENTRY_DSN=
